<misterromdescription>
    <name>Krull</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1983</year>
    <manufacturer>Gottlieb</manufacturer>
    <category>Action</category>

    <setname>krull</setname>
    <parent>krull</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way (move) + 8-way (fire)</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire Up,Fire Down,Fire Left,Fire Right,Coin,Start 1P,Start 2P,Pause,-,-" default="X,B,Y,A,Select,Start,R,L"/>

    <switches default="00">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Difficulty" bits="1" ids="Normal,Hard"/>
        <dip name="Coinage" bits="2,3" ids="1 Coin/1 Credit,2 Coins/1 Credit,1 Coin/2 Credits,Free Play"/>
        <dip name="Lives" bits="4" ids="3,5"/>
        <dip name="Hexagon" bits="5" ids="Roving,Stationary"/>
        <dip name="Bonus Life" bits="6,7" ids="30k 80k and every 50k,30k 60k and every 30k,40k 90k and every 50k,50k 125k and every 75k"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
