<misterromdescription>
    <name>Curve Ball</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1984</year>
    <manufacturer>Mylstar</manufacturer>
    <category>Sports</category>

    <setname>curvebal</setname>
    <parent>curvebal</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>buttons only</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Swing / Pitch Left,Bunt / Pitch Right,-,-,Coin,-,-,Pause,-,-" default="A,B,Select,L"/>

    <switches default="20">
        <dip name="Difficulty" bits="0,1" ids="Easy,Hard,Medium,Very Hard"/>
        <dip name="Coinage" bits="2,4" ids="A 1/1 B 1/1,A 2/1 B 2/3 / A 2/1 B 1/1,A 1/1 B 1/3 / A 2/1 B 1/3,A 3/1 B 1/2 / A 4/1 B 1/1,A 1/1 B 1/2 / A 2/1 B 1/2,A 1/5 B 1/2 / A 3/1 B 1/1,A 2/1 B 2/1,Free Play"/>
        <dip name="Demo Sounds" bits="5" ids="Off,On"/>
        <dip name="2 Players Game" bits="6" ids="2 Credits,1 Credit"/>
        <dip name="Coins" bits="7" ids="Normal,French"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
