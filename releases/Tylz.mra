<misterromdescription>
    <name>Tylz</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Prototype</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1982</year>
    <manufacturer>Mylstar</manufacturer>
    <category>Maze</category>

    <setname>tylz</setname>
    <parent>tylz</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Button 1,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="A,Select,Start,R,L"/>

    <switches default="20,80">
        <dip name="Coinage" bits="0,1" ids="1 Coin/1 Credit,2 Coins/1 Credit,1 Coin/2 Credits,Free Play"/>
        <dip name="Bonus Life" bits="2,3" ids="15k 35k and every 20k,20k 55k and every 35k,15k 45k and every 30k,20k 60k and every 40k"/>
        <dip name="Lives" bits="4" ids="3,5"/>
        <dip name="Demo Sounds" bits="5" ids="Off,On"/>
        <dip name="Difficulty" bits="6,7" ids="Easy,Normal Easy,Normal Hard,Hard"/>
        <dip name="Unknown" bits="15" ids="On,Off"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
         speech 0x20000 (layout in tools/make_mra.py, rtl/gottlieb_board.sv). Generated by tools/make_mra.py -->
    <rom index="0" md5="none" zip="tylz.zip|votrsc01a.zip">
        <part repeat="0x2000">00</part>
        <part crc="28ed146d" name="tylz.s4t"/>
        <part crc="18ee09f9" name="tylz.s4b"/>
        <part crc="657c3d2e" name="tylz.r4"/>
        <part crc="b2a15510" name="tylz.n4"/>
        <part repeat="0x2000">00</part>
        <part crc="5e300b9b" name="tylz.m6"/>
        <part crc="af56292e" name="tylz.n6"/>
        <part repeat="0x1000">00</part>
        <part crc="ebcedba9" name="tylz.f2"/>
        <part crc="ff62bc4b" name="tylz.k12"/>
        <part repeat="0x2000">00</part>
        <part crc="bc319067" name="tylz.j12"/>
        <part repeat="0x2000">00</part>
        <part crc="1eb26e6f" name="tylz.g12"/>
        <part repeat="0x2000">00</part>
        <part crc="6d2c5ad8" name="tylz.f12"/>
        <part repeat="0x6000">00</part>
        <part crc="fc416227" name="sc01a.bin"/>
    </rom>

    <!-- Index 1: set id, flags, port idle levels, DIP sources, input map (tools/mra_cfg.py), board config bytes 148-152 -->
    <rom index="1">
        <part>
            09 00 00 00 08 01 FF FF 80 00 00 00 00 80 80 80
            01 80 80 80 00 00 00 00 00 00 00 00 16 2F 12 11
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 02 04 01 03 05 13 14 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 02 04 05 01 03 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 03 03 00 00
        </part>
    </rom>

    <!-- Index 4: battery-backed CMOS RAM (4096 bytes) -->
    <nvram index="4" size="4096"/>

    <remark>Tylz (Mylstar)</remark>
