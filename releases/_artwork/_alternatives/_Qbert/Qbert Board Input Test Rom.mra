    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way (diagonal: pad Up = up-right)</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="-,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="Select,Start,R,L"/>

    <switches default="02">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Kicker" bits="1" ids="Off,On"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Demo Mode (Cheat)" bits="3" ids="Off,On"/>
        <dip name="Free Play" bits="4" ids="Off,On"/>
    </switches>

