<misterromdescription>
    <name>Q*bert Board Input Test Rom</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Q*bert</series>
