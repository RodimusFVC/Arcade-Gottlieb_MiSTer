        <dip name="Kicker" bits="1" ids="Off,On"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Demo Mode (Cheat)" bits="3" ids="Off,On"/>
        <dip name="Free Play" bits="4" ids="Off,On"/>
