    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way + dial: mouse X, left analog stick or D-pad</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1,Button 2,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="A,B,Select,Start,R,L"/>

    <switches default="00">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Bonus Life" bits="1" ids="Every 10000,Every 12000"/>
        <dip name="Coinage" bits="2,3" ids="1 Coin/1 Credit,2 Coins/1 Credit,1 Coin/2 Credits,Free Play"/>
        <dip name="Allow Round Select" bits="4" ids="No,Yes"/>
        <dip name="Lives" bits="5" ids="3,5"/>
        <dip name="Difficulty" bits="6,7" ids="Standard,Easy,Hard,Very Hard"/>
    </switches>

