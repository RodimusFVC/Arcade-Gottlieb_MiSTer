<misterromdescription>
    <name>Q*bert's Qubes</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Q*bert</series>
    <year>1983</year>
    <manufacturer>Mylstar</manufacturer>
    <category>Puzzle</category>

    <setname>qbertqub</setname>
    <parent>qbertqub</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way (diagonal: pad Up = up-right)</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="-,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="Select,Start,R,L"/>

    <switches default="00">
        <dip name="Coinage" bits="0,3" ids="A 1/1 B 1/1,Unused,A 1/3 B 2/1,A 1/3 B 1/1,A 1/1 B 2/1,A 2/3 B 2/1,A 1/1 B 4/1,A 1/2 B 3/1,A 1/2 B 2/1,A 1/2 B 1/1,A 2/1 B 2/1,Unused,A 1/1 B 3/1,A 1/2 B 1/5,Unused,Free Play"/>
        <dip name="Bonus Life at" bits="4" ids="10000,15000"/>
        <dip name="Demo Sounds" bits="5" ids="On,Off"/>
        <dip name="Additional Bonus Life Every" bits="6" ids="20000,25000"/>
        <dip name="Difficulty" bits="7" ids="Normal,Hard"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
         speech 0x20000 (layout in tools/make_mra.py, rtl/gottlieb_board.sv). Generated by tools/make_mra.py -->
    <rom index="0" md5="none" zip="qbertqub.zip|votrsc01a.zip">
        <part repeat="0x2000">00</part>
        <part crc="c4dbdcd7" name="qq-rom3.bin"/>
        <part crc="21a6c6cc" name="qq-rom2.bin"/>
        <part crc="63e6c43d" name="qq-rom1.bin"/>
        <part crc="8ddbe438" name="qq-rom0.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="050badde" name="qq-bg0.bin"/>
        <part crc="8875902f" name="qq-bg1.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="e704b450" name="qq-snd1.bin"/>
        <part crc="c6a98bf8" name="qq-snd2.bin"/>
        <part crc="91a949cc" name="qq-fg3.bin"/>
        <part crc="782d9431" name="qq-fg2.bin"/>
        <part crc="71c3ac4c" name="qq-fg1.bin"/>
        <part crc="6192853f" name="qq-fg0.bin"/>
        <part repeat="0x4000">00</part>
        <part crc="fc416227" name="sc01a.bin"/>
    </rom>

    <!-- Index 1: set id, flags, port idle levels, DIP sources, input map (tools/mra_cfg.py), board config bytes 148-152 -->
    <rom index="1">
        <part>
            10 11 00 00 00 40 FF FF 00 00 00 00 00 80 80 80
            80 80 80 80 00 00 00 00 00 00 00 00 13 14 12 11
            00 00 16 2F 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 04 03 01 02 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 04 01 05 02 03 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 01 02 03 04 05 06 07 00 01 02 03
            04 05 06 07 00 03 03 02 00
        </part>
    </rom>

    <!-- Index 4: battery-backed CMOS RAM (4096 bytes) -->
    <nvram index="4" size="4096"/>

    <remark>Q*bert's Qubes (Mylstar)</remark>
