        <dip name="Difficulty" bits="3" ids="Normal,Hard"/>
        <dip name="Lives" bits="5" ids="3,5"/>
        <dip name="Coinage" bits="6,7" ids="1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit,Free Play"/>
    </switches>

