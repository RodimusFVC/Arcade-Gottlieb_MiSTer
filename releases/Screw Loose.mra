<misterromdescription>
    <name>Screw Loose</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Prototype</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1983</year>
    <manufacturer>Mylstar</manufacturer>
    <category>Platform</category>

    <setname>screwloo</setname>
    <parent>screwloo</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way (left) + 8-way (right)</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Right Up,Right Down,Right Left,Right Right,Coin,Start 1P,Start 2P,Pause,-,-" default="X,B,Y,A,Select,Start,R,L"/>

    <switches default="20">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Demo mode" bits="1" ids="Off,On"/>
        <dip name="1st Bonus Atom at" bits="2" ids="5000,20000"/>
        <dip name="Free Play" bits="3" ids="Off,On"/>
        <dip name="Coinage" bits="4,5" ids="2 Coins/1 Credit,2 Coins/2 Credits,1 Coin/1 Credit,1 Coin/2 Credits"/>
        <dip name="1st Bonus Hand at" bits="6" ids="25000,50000"/>
        <dip name="Hands" bits="7" ids="3,5"/>
    </switches>

