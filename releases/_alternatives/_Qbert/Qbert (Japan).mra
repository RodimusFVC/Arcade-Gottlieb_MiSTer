<misterromdescription>
    <name>Q*bert (Japan)</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Q*bert</series>
    <year>1982</year>
    <manufacturer>Gottlieb (Konami license)</manufacturer>
    <category>Platform</category>

    <setname>qbertj</setname>
    <parent>qbert</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way (diagonal: pad Up = up-right)</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="-,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-" default="Select,Start,R,L"/>

    <switches default="02">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Kicker" bits="1" ids="Off,On"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Demo Mode (Cheat)" bits="3" ids="Off,On"/>
        <dip name="Free Play" bits="4" ids="Off,On"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
         speech 0x20000 (layout in tools/make_mra.py, rtl/gottlieb_board.sv). Generated by tools/make_mra.py -->
    <rom index="0" md5="none" zip="qbertj.zip|qbert.zip|votrsc01a.zip">
        <part repeat="0x4000">00</part>
        <part crc="67bb1cb2" name="qbj-rom2.bin"/>
        <part crc="c61216e7" name="qbj-rom1.bin"/>
        <part crc="69679d5c" name="qbj-rom0.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="7a9ba824" name="qb-bg0.bin"/>
        <part crc="22e5b891" name="qb-bg1.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="15787c07" name="qb-snd1.bin"/>
        <part crc="58437508" name="qb-snd2.bin"/>
        <part crc="dd436d3a" name="qb-fg3.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="f69b9483" name="qb-fg2.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="224e8356" name="qb-fg1.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="2f695b85" name="qb-fg0.bin"/>
        <part repeat="0x6000">00</part>
        <part crc="fc416227" name="sc01a.bin"/>
    </rom>

    <!-- Index 1: set id, flags, port idle levels, DIP sources, input map (tools/mra_cfg.py), board config bytes 148-152 -->
    <rom index="1">
        <part>
            04 11 00 00 02 40 FF FF 00 00 00 00 00 80 80 80
            80 80 80 80 00 00 00 00 00 00 00 00 13 14 11 12
            00 00 16 2F 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 04 03 01 02 0C 0B 09 0A 00 00 00 00
