        <part crc="3dd73b94" name="bg1"/>
        <part repeat="0x1000">00</part>
        <part crc="25bcc8bc" name="gv106s.bin"/>
        <part crc="9bbf5b6b" name="fg3"/>
        <part repeat="0x2000">00</part>
        <part crc="5adf9986" name="fg2"/>
        <part repeat="0x2000">00</part>
        <part crc="4bb16111" name="fg1"/>
        <part repeat="0x2000">00</part>
        <part crc="965f6b76" name="fg0"/>
    </rom>

    <!-- Index 1: set id, flags, port idle levels, DIP sources, input map (tools/mra_cfg.py), board config bytes 148-152 -->
    <rom index="1">
