<misterromdescription>
    <name>Insector</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version>Prototype</version>
    <alternative></alternative>
    <platform></platform>
    <series></series>
    <year>1982</year>
    <manufacturer>Gottlieb</manufacturer>
    <category>Shooter</category>

    <setname>insector</setname>
    <parent>insector</parent>
    <mameversion>0289</mameversion>
    <rbf>Gottlieb</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Button 1 (Start 1P),Button 2 (Start 2P),-,-,Coin,-,-,Pause,-,-" default="A,B,Select,L"/>

    <switches default="08">
        <dip name="Bonus Life" bits="0" ids="25k 75k and every 50k,30k 90k and every 60k"/>
        <dip name="Demo Sounds" bits="1" ids="On,Off"/>
        <dip name="Demo Mode (Cheat)" bits="2" ids="Off,On"/>
        <dip name="Lives" bits="3" ids="5,3"/>
        <dip name="Coinage" bits="4,5" ids="1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit,2 Coins/2 Credits"/>
        <dip name="Free Play" bits="6" ids="Off,On"/>
        <dip name="Cabinet" bits="7" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: main CPU ROMs 0x00000, background tiles 0x0C000, Rev 1 / Rev 2 sound 0x0E000, sprite bitplanes 0x10000,
         speech 0x20000 (layout in tools/make_mra.py, rtl/gottlieb_board.sv). Generated by tools/make_mra.py -->
